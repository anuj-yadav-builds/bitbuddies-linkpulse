# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your password stays on your laptop.

SECRET_KEY=change-this-to-any-long-random-text

# --- MySQL (local or Aiven) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=linkpulse

# Aiven needs SSL. Keep this false for local MySQL, set true for Aiven.
DB_SSL=false

# Leave empty on your laptop. On Render set it to your live link,
# for example https://bitbuddies-linkpulse.onrender.com
BASE_URL=

# The account with this email becomes the ADMIN (can disable links, block domains).
# Register with this same email. If you leave it empty, the first person who registers is admin.
ADMIN_EMAIL=your-email@example.com

# India is UTC+5:30 = 330 minutes. Used so "clicks per day" follows IST.
TZ_OFFSET_MINUTES=330
